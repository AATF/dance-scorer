<div class="row justify-content-center my-5">
  <div class="col-12 col-md-8 col-lg-6">
    <div class="card border shadow-sm text-center p-4 p-md-5" style="border-radius: 16px;">
      <div class="card-body">
        <div>
          <span class="badge rounded-pill px-3 py-2 text-uppercase mb-3" style="background-color: <%= @details[:bg] %>; color: <%= @details[:color] %>; font-size: 0.875rem; font-weight: 700; letter-spacing: 0.05em;">
            Error <%= @status_code %>
          </span>
        </div>
        <h1 class="display-3 fw-bold mb-2" style="color: <%= @details[:color] %>;">
          <%= @status_code %>
        </h1>
        <h2 class="h4 fw-bold text-dark mb-3">
          <%= @title %>
        </h2>
        <p class="text-muted mb-4 lead" style="font-size: 1.05rem;">
          <%= @message %>
        </p>
        <div class="d-flex justify-content-center gap-2 flex-wrap">
          <%= link_to "Return to Home", root_path, class: "btn btn-primary px-4 py-2" %>
          <a href="javascript:history.back()" class="btn btn-outline-secondary px-4 py-2">Go Back</a>
        </div>
      </div>
    </div>
  </div>
</div>

