<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= page_title(@title) %></title>
    <%= csrf_meta_tags %>

    <%# stylesheet_link_tag 'application', media: 'all' %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
      <div class="container-fluid">
        <%= link_to "Home", root_path, class: "navbar-brand mb-0 h1" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarSupportedContent">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <% if session[:logged_in] %>
              <li class="nav-item"><%= link_to "Groups", groups_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "Dancers", dancers_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "Scores", scores_path, class: "nav-link" %></li>

              <% if @current_user&.admin? %>
                <li class="nav-item"><%= link_to "Users", users_path, class: "nav-link" %></li>
                <li class="nav-item"><%= link_to "Admin", admin_index_path, class: "nav-link" %></li>
              <% end %>
            <% end %>
          </ul>

          <ul class="navbar-nav ms-auto mb-2 mb-lg-0 navbar-right">
            <% if session[:logged_in] && @current_user %>
              <li class="nav-item"><%= link_to @current_user.name, user_path(session[:user_id]), class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "Logout", logout_path, class: "nav-link" %></li>
            <% else %>
              <li class="nav-item"><%= link_to "Login", login_path, class: "nav-link" %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container mt-4">
      <% if flash[:notice] %>
        <p class="notice alert alert-info"><%= flash[:notice] %></p>
      <% elsif flash[:warning] %>
        <p class="alert alert-warning">WARNING: <%= flash[:warning] %></p>
      <% end %>

      <% if @header.present? %>
        <h1><%= @header %></h1>
      <% end %>

      <%= yield %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  </body>
</html>
